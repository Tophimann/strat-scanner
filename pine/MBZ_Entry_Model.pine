//@version=6
indicator("MBZ Entry Model by NINE", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================================================================
// INPUTS
// ============================================================================
grpPOI = "FVG / POI"
showFvgBox   = input.bool(true, "FVG Box anzeigen", group = grpPOI)
bullPoiColor = input.color(color.new(color.teal, 85), "Bullish FVG Farbe", group = grpPOI)
bearPoiColor = input.color(color.new(color.red, 85), "Bearish FVG Farbe", group = grpPOI)

grpMbz = "MBZ / Entry"
showC1Line   = input.bool(true, "C1 0.5-Linie (Validierungs-Schwelle) anzeigen", group = grpMbz)
showZoneBox  = input.bool(true, "C2 Body-Zone (0/1) anzeigen", group = grpMbz)
showEntry    = input.bool(true, "Entry-Linie (0.5 von C2) anzeigen", group = grpMbz)
showStopLvls = input.bool(true, "Stop-Referenzlevel (1.5 / 2) anzeigen", group = grpMbz)
showTpLvls   = input.bool(true, "Ziel-Referenzlevel (-1/-2/-4/-6/-7) anzeigen", group = grpMbz)
extendInfinite = input.bool(true, "Level-Linien unendlich nach rechts verlängern", group = grpMbz)
projectionBars = input.int(40, "Projektionslänge (Bars), falls nicht unendlich", minval = 5, group = grpMbz)

longColor  = input.color(color.new(color.lime, 0), "Long Farbe", group = grpMbz)
shortColor = input.color(color.new(color.red, 0), "Short Farbe", group = grpMbz)
stopColor  = input.color(color.new(color.gray, 40), "Stop-Level Farbe", group = grpMbz)
tpColor    = input.color(color.new(color.green, 40), "Ziel-Level Farbe", group = grpMbz)

showLabels = input.bool(true, "C1/C2/C3/Entry Labels anzeigen", group = "Anzeige")

// ============================================================================
// HELPERS
// ============================================================================
median(o, c) => (o + c) / 2

f_extend() => extendInfinite ? extend.right : extend.none
f_x2(_x1) => extendInfinite ? _x1 + 1 : _x1 + projectionBars

f_line(_x1, _y1, _y2, _col, _style, _width) =>
    line.new(_x1, _y1, f_x2(_x1), _y2, xloc = xloc.bar_index, extend = f_extend(), color = _col, style = _style, width = _width)

f_label(_x, _y, _txt, _col) =>
    label.new(_x, _y, _txt, xloc = xloc.bar_index, style = label.style_none, color = color.new(_col, 100), textcolor = _col, size = size.small)

f_clearLines(arr) =>
    if array.size(arr) > 0
        for ln in arr
            line.delete(ln)
        array.clear(arr)

f_clearLabels(arr) =>
    if array.size(arr) > 0
        for lb in arr
            label.delete(lb)
        array.clear(arr)

tagOffsetMult = input.float(1.0, "C1/C2/C3 Textabstand von der Kerze (x ATR)", minval = 0, group = "Anzeige")
tagOffset = ta.atr(14) * tagOffsetMult

// ============================================================================
// FVG DETECTION (classic 3-candle, wick based, single timeframe — chart TF)
// ============================================================================
bullFvg = low > high[2]
bearFvg = high < low[2]

var float bullPoiTop = na
var float bullPoiBot = na
var int   bullPoiLeft = na
var int   bullPoiFormBar = na  // bar index of candle 3 — the FVG isn't complete until after this bar
var bool  bullPoiMitigated = true
var box   bullPoiBox = na

var float bearPoiTop = na
var float bearPoiBot = na
var int   bearPoiLeft = na
var int   bearPoiFormBar = na
var bool  bearPoiMitigated = true
var box   bearPoiBox = na

// mitigation of existing POIs (full close-through invalidates them as usable POIs)
if not bullPoiMitigated and close < bullPoiBot
    bullPoiMitigated := true
    if not na(bullPoiBox)
        box.delete(bullPoiBox)
        bullPoiBox := na
if not bearPoiMitigated and close > bearPoiTop
    bearPoiMitigated := true
    if not na(bearPoiBox)
        box.delete(bearPoiBox)
        bearPoiBox := na

// register newest, non-mitigated FVG only — replaces (deletes) whatever POI box was drawn before
if bullFvg
    bullPoiTop := low
    bullPoiBot := high[2]
    bullPoiLeft := bar_index[2]
    bullPoiFormBar := bar_index
    bullPoiMitigated := false
    if not na(bullPoiBox)
        box.delete(bullPoiBox)
        bullPoiBox := na
    if showFvgBox
        bullPoiBox := box.new(bullPoiLeft, bullPoiTop, bar_index, bullPoiBot, border_color = na, bgcolor = bullPoiColor)

if bearFvg
    bearPoiTop := low[2]
    bearPoiBot := high
    bearPoiLeft := bar_index[2]
    bearPoiFormBar := bar_index
    bearPoiMitigated := false
    if not na(bearPoiBox)
        box.delete(bearPoiBox)
        bearPoiBox := na
    if showFvgBox
        bearPoiBox := box.new(bearPoiLeft, bearPoiTop, bar_index, bearPoiBot, border_color = na, bgcolor = bearPoiColor)

// keep active POI boxes growing to the right until mitigated
if showFvgBox and not na(bullPoiBox) and not bullPoiMitigated
    box.set_right(bullPoiBox, bar_index)
if showFvgBox and not na(bearPoiBox) and not bearPoiMitigated
    box.set_right(bearPoiBox, bar_index)

// ============================================================================
// LONG SETUP
// C1: bearish candle touching a bullish FVG
// C2: very next candle, closes bullish above C1's 0.5   -> entry = 0.5 of C2
// C3: very next candle after C2, MUST trade back down into the entry level,
//     otherwise the whole setup is discarded (no trade)
// Only the newest fully-triggered setup is ever kept on the chart.
// ============================================================================
var bool  longC1Set   = false
var float longC1Open  = na
var float longC1Close = na
var int   longC1Bar   = na
var line  longC1Line  = na
var label longC1PendingLabel   = na  // "C1" tag while the setup is still unconfirmed
var label longC1ConfirmedLabel = na  // "C1" tag of the currently displayed (triggered) setup

var bool  longC2Set   = false  // C2 validated, waiting one bar for C3 to trigger
var float longEntry     = na
var float longC2Open    = na
var float longC2Close   = na
var int   longC2Bar     = na
var float longC2Low     = na   // C2's own low — shared height reference for C1/C2/C3 tags
var label longC2PendingLabel = na
var label longC2Label        = na
var label longC3Label        = na

var box   longZoneBox   = na
var line  longEntryLine = na
var label longEntryLabel = na
var array<line>  longSlLines  = array.new_line()
var array<label> longSlLabels = array.new_label()
var array<line>  longTpLines  = array.new_line()
var array<label> longTpLabels = array.new_label()

longEntryEvent = false

// a fresher FVG just formed -> it replaces the old one entirely, so drop any
// pending/in-progress C1-C2-C3 chain AND any already-triggered setup tied to
// the superseded FVG
if bullFvg
    longC1Set := false
    longC2Set := false
    if not na(longC1Line)
        line.delete(longC1Line)
        longC1Line := na
    if not na(longC1PendingLabel)
        label.delete(longC1PendingLabel)
        longC1PendingLabel := na
    if not na(longC2PendingLabel)
        label.delete(longC2PendingLabel)
        longC2PendingLabel := na
    if not na(longC3Label)
        label.delete(longC3Label)
        longC3Label := na
    if not na(longC1ConfirmedLabel)
        label.delete(longC1ConfirmedLabel)
        longC1ConfirmedLabel := na
    if not na(longC2Label)
        label.delete(longC2Label)
        longC2Label := na
    if not na(longZoneBox)
        box.delete(longZoneBox)
        longZoneBox := na
    if not na(longEntryLine)
        line.delete(longEntryLine)
        longEntryLine := na
    if not na(longEntryLabel)
        label.delete(longEntryLabel)
        longEntryLabel := na
    f_clearLines(longSlLines)
    f_clearLabels(longSlLabels)
    f_clearLines(longTpLines)
    f_clearLabels(longTpLabels)

// C1 -> C2: attempt validation on the candle immediately following C1
if longC1Set and bar_index == longC1Bar + 1
    validated = close > open and close > median(longC1Open, longC1Close)
    if validated
        longC2Open := open
        longC2Close := close
        longC2Bar := bar_index
        longC2Low := low
        longEntry := median(open, close)
        longC2Set := true
        if showLabels
            longC2PendingLabel := f_label(bar_index, low - tagOffset, "C2", longColor)
    longC1Set := false
    if not na(longC1Line)
        line.delete(longC1Line)
        longC1Line := na
    if not validated and not na(longC1PendingLabel)
        label.delete(longC1PendingLabel)
        longC1PendingLabel := na

// C2 -> C3: the very next candle after C2 must trade back into the entry level
// (0.5 of C2), otherwise the whole C1/C2 chain is discarded — no trade
if longC2Set and bar_index == longC2Bar + 1
    if low <= longEntry
        longEntryEvent := true
    else
        if not na(longC1PendingLabel)
            label.delete(longC1PendingLabel)
            longC1PendingLabel := na
        if not na(longC2PendingLabel)
            label.delete(longC2PendingLabel)
            longC2PendingLabel := na
    longC2Set := false

// new C1: bearish candle whose range touches (even by 1 pip) the active, non-mitigated bullish FVG
// — must come strictly after the FVG's own 3-candle formation, never be part of it
if not bullPoiMitigated and not na(bullPoiTop) and bar_index > bullPoiFormBar and close < open and low <= bullPoiTop and high >= bullPoiBot
    if not na(longC1Line)
        line.delete(longC1Line)
    if not na(longC1PendingLabel)
        label.delete(longC1PendingLabel)
        longC1PendingLabel := na
    longC1Open := open
    longC1Close := close
    longC1Bar := bar_index
    longC1Set := true
    if showC1Line
        longC1Line := line.new(bar_index, median(open, close), bar_index + 1, median(open, close), xloc = xloc.bar_index, color = longColor, style = line.style_dotted, width = 1)
    if showLabels
        longC1PendingLabel := f_label(bar_index, low - tagOffset, "C1", longColor)

if longC1Set and showC1Line and not na(longC1Line)
    line.set_x2(longC1Line, bar_index + 1)

// C3 triggered -> draw the confirmed C1/C2/C3 tags, the C2 zone, entry and projected levels
if longEntryEvent
    // remove everything that belonged to the previous triggered setup first
    if not na(longC1ConfirmedLabel)
        label.delete(longC1ConfirmedLabel)
        longC1ConfirmedLabel := na
    if not na(longC2Label)
        label.delete(longC2Label)
        longC2Label := na
    if not na(longC3Label)
        label.delete(longC3Label)
        longC3Label := na
    if not na(longZoneBox)
        box.delete(longZoneBox)
        longZoneBox := na
    if not na(longEntryLine)
        line.delete(longEntryLine)
        longEntryLine := na
    if not na(longEntryLabel)
        label.delete(longEntryLabel)
        longEntryLabel := na
    f_clearLines(longSlLines)
    f_clearLabels(longSlLabels)
    f_clearLines(longTpLines)
    f_clearLabels(longTpLabels)

    // promote the pending C1/C2 tags to confirmed, all three aligned at the same height
    longC1ConfirmedLabel := longC1PendingLabel
    longC1PendingLabel := na
    if not na(longC1ConfirmedLabel)
        label.set_y(longC1ConfirmedLabel, longC2Low - tagOffset)
    longC2Label := longC2PendingLabel
    longC2PendingLabel := na
    if not na(longC2Label)
        label.set_y(longC2Label, longC2Low - tagOffset)
    if showLabels
        longC3Label := f_label(bar_index, longC2Low - tagOffset, "C3", longColor)

    unit = longC2Close - longC2Open
    if unit > 0
        x1 = longC2Bar
        if showZoneBox
            longZoneBox := box.new(x1, longC2Close, x1 + 1, longC2Open, border_color = na, bgcolor = color.new(longColor, 90))
        if showEntry
            longEntryLine := f_line(x1, longEntry, longEntry, longColor, line.style_dashed, 1)
            if showLabels
                longEntryLabel := f_label(f_x2(x1), longEntry, "Entry " + str.tostring(longEntry, format.mintick), longColor)
        if showStopLvls
            for n = 1.5 to 2.0 by 0.5
                lvl = longC2Close - n * unit
                array.push(longSlLines, f_line(x1, lvl, lvl, stopColor, line.style_dashed, 1))
                if showLabels
                    array.push(longSlLabels, f_label(f_x2(x1), lvl, "SL " + str.tostring(n) + " (" + str.tostring(lvl, format.mintick) + ")", stopColor))
        if showTpLvls
            for n in array.from(-1.0, -2.0, -4.0, -6.0, -7.0)
                lvl = longC2Close - n * unit
                array.push(longTpLines, f_line(x1, lvl, lvl, tpColor, line.style_dashed, 1))
                if showLabels
                    array.push(longTpLabels, f_label(f_x2(x1), lvl, "TP " + str.tostring(-n) + " (" + str.tostring(lvl, format.mintick) + ")", tpColor))

// ============================================================================
// SHORT SETUP (mirror of long)
// ============================================================================
var bool  shortC1Set   = false
var float shortC1Open  = na
var float shortC1Close = na
var int   shortC1Bar   = na
var line  shortC1Line  = na
var label shortC1PendingLabel   = na
var label shortC1ConfirmedLabel = na

var bool  shortC2Set   = false
var float shortEntry     = na
var float shortC2Open    = na
var float shortC2Close   = na
var int   shortC2Bar     = na
var float shortC2High    = na
var label shortC2PendingLabel = na
var label shortC2Label        = na
var label shortC3Label        = na

var box   shortZoneBox   = na
var line  shortEntryLine = na
var label shortEntryLabel = na
var array<line>  shortSlLines  = array.new_line()
var array<label> shortSlLabels = array.new_label()
var array<line>  shortTpLines  = array.new_line()
var array<label> shortTpLabels = array.new_label()

shortEntryEvent = false

// a fresher FVG just formed -> it replaces the old one entirely, so drop any
// pending/in-progress C1-C2-C3 chain AND any already-triggered setup tied to
// the superseded FVG
if bearFvg
    shortC1Set := false
    shortC2Set := false
    if not na(shortC1Line)
        line.delete(shortC1Line)
        shortC1Line := na
    if not na(shortC1PendingLabel)
        label.delete(shortC1PendingLabel)
        shortC1PendingLabel := na
    if not na(shortC2PendingLabel)
        label.delete(shortC2PendingLabel)
        shortC2PendingLabel := na
    if not na(shortC3Label)
        label.delete(shortC3Label)
        shortC3Label := na
    if not na(shortC1ConfirmedLabel)
        label.delete(shortC1ConfirmedLabel)
        shortC1ConfirmedLabel := na
    if not na(shortC2Label)
        label.delete(shortC2Label)
        shortC2Label := na
    if not na(shortZoneBox)
        box.delete(shortZoneBox)
        shortZoneBox := na
    if not na(shortEntryLine)
        line.delete(shortEntryLine)
        shortEntryLine := na
    if not na(shortEntryLabel)
        label.delete(shortEntryLabel)
        shortEntryLabel := na
    f_clearLines(shortSlLines)
    f_clearLabels(shortSlLabels)
    f_clearLines(shortTpLines)
    f_clearLabels(shortTpLabels)

// C1 -> C2: attempt validation on the candle immediately following C1
if shortC1Set and bar_index == shortC1Bar + 1
    validated = close < open and close < median(shortC1Open, shortC1Close)
    if validated
        shortC2Open := open
        shortC2Close := close
        shortC2Bar := bar_index
        shortC2High := high
        shortEntry := median(open, close)
        shortC2Set := true
        if showLabels
            shortC2PendingLabel := f_label(bar_index, high + tagOffset, "C2", shortColor)
    shortC1Set := false
    if not na(shortC1Line)
        line.delete(shortC1Line)
        shortC1Line := na
    if not validated and not na(shortC1PendingLabel)
        label.delete(shortC1PendingLabel)
        shortC1PendingLabel := na

// C2 -> C3: the very next candle after C2 must trade back into the entry level
// (0.5 of C2), otherwise the whole C1/C2 chain is discarded — no trade
if shortC2Set and bar_index == shortC2Bar + 1
    if high >= shortEntry
        shortEntryEvent := true
    else
        if not na(shortC1PendingLabel)
            label.delete(shortC1PendingLabel)
            shortC1PendingLabel := na
        if not na(shortC2PendingLabel)
            label.delete(shortC2PendingLabel)
            shortC2PendingLabel := na
    shortC2Set := false

// new C1: bullish candle whose range touches (even by 1 pip) the active, non-mitigated bearish FVG
// — must come strictly after the FVG's own 3-candle formation, never be part of it
if not bearPoiMitigated and not na(bearPoiBot) and bar_index > bearPoiFormBar and close > open and high >= bearPoiBot and low <= bearPoiTop
    if not na(shortC1Line)
        line.delete(shortC1Line)
    if not na(shortC1PendingLabel)
        label.delete(shortC1PendingLabel)
        shortC1PendingLabel := na
    shortC1Open := open
    shortC1Close := close
    shortC1Bar := bar_index
    shortC1Set := true
    if showC1Line
        shortC1Line := line.new(bar_index, median(open, close), bar_index + 1, median(open, close), xloc = xloc.bar_index, color = shortColor, style = line.style_dotted, width = 1)
    if showLabels
        shortC1PendingLabel := f_label(bar_index, high + tagOffset, "C1", shortColor)

if shortC1Set and showC1Line and not na(shortC1Line)
    line.set_x2(shortC1Line, bar_index + 1)

// C3 triggered -> draw the confirmed C1/C2/C3 tags, the C2 zone, entry and projected levels
if shortEntryEvent
    if not na(shortC1ConfirmedLabel)
        label.delete(shortC1ConfirmedLabel)
        shortC1ConfirmedLabel := na
    if not na(shortC2Label)
        label.delete(shortC2Label)
        shortC2Label := na
    if not na(shortC3Label)
        label.delete(shortC3Label)
        shortC3Label := na
    if not na(shortZoneBox)
        box.delete(shortZoneBox)
        shortZoneBox := na
    if not na(shortEntryLine)
        line.delete(shortEntryLine)
        shortEntryLine := na
    if not na(shortEntryLabel)
        label.delete(shortEntryLabel)
        shortEntryLabel := na
    f_clearLines(shortSlLines)
    f_clearLabels(shortSlLabels)
    f_clearLines(shortTpLines)
    f_clearLabels(shortTpLabels)

    // promote the pending C1/C2 tags to confirmed, all three aligned at the same height
    shortC1ConfirmedLabel := shortC1PendingLabel
    shortC1PendingLabel := na
    if not na(shortC1ConfirmedLabel)
        label.set_y(shortC1ConfirmedLabel, shortC2High + tagOffset)
    shortC2Label := shortC2PendingLabel
    shortC2PendingLabel := na
    if not na(shortC2Label)
        label.set_y(shortC2Label, shortC2High + tagOffset)
    if showLabels
        shortC3Label := f_label(bar_index, shortC2High + tagOffset, "C3", shortColor)

    unit = shortC2Close - shortC2Open // negative for a bearish C2
    if unit < 0
        x1 = shortC2Bar
        if showZoneBox
            shortZoneBox := box.new(x1, shortC2Close, x1 + 1, shortC2Open, border_color = na, bgcolor = color.new(shortColor, 90))
        if showEntry
            shortEntryLine := f_line(x1, shortEntry, shortEntry, shortColor, line.style_dashed, 1)
            if showLabels
                shortEntryLabel := f_label(f_x2(x1), shortEntry, "Entry " + str.tostring(shortEntry, format.mintick), shortColor)
        if showStopLvls
            for n = 1.5 to 2.0 by 0.5
                lvl = shortC2Close - n * unit
                array.push(shortSlLines, f_line(x1, lvl, lvl, stopColor, line.style_dashed, 1))
                if showLabels
                    array.push(shortSlLabels, f_label(f_x2(x1), lvl, "SL " + str.tostring(n) + " (" + str.tostring(lvl, format.mintick) + ")", stopColor))
        if showTpLvls
            for n in array.from(-1.0, -2.0, -4.0, -6.0, -7.0)
                lvl = shortC2Close - n * unit
                array.push(shortTpLines, f_line(x1, lvl, lvl, tpColor, line.style_dashed, 1))
                if showLabels
                    array.push(shortTpLabels, f_label(f_x2(x1), lvl, "TP " + str.tostring(-n) + " (" + str.tostring(lvl, format.mintick) + ")", tpColor))

// ============================================================================
// ONLY ONE SETUP GLOBALLY — a fresh trigger, long or short, clears whatever
// the other direction still had on the chart, confirmed or in-progress
// ============================================================================
if longEntryEvent
    shortC1Set := false
    shortC2Set := false
    if not na(shortC1Line)
        line.delete(shortC1Line)
        shortC1Line := na
    if not na(shortC1PendingLabel)
        label.delete(shortC1PendingLabel)
        shortC1PendingLabel := na
    if not na(shortC2PendingLabel)
        label.delete(shortC2PendingLabel)
        shortC2PendingLabel := na
    if not na(shortC3Label)
        label.delete(shortC3Label)
        shortC3Label := na
    if not na(shortC1ConfirmedLabel)
        label.delete(shortC1ConfirmedLabel)
        shortC1ConfirmedLabel := na
    if not na(shortC2Label)
        label.delete(shortC2Label)
        shortC2Label := na
    if not na(shortZoneBox)
        box.delete(shortZoneBox)
        shortZoneBox := na
    if not na(shortEntryLine)
        line.delete(shortEntryLine)
        shortEntryLine := na
    if not na(shortEntryLabel)
        label.delete(shortEntryLabel)
        shortEntryLabel := na
    f_clearLines(shortSlLines)
    f_clearLabels(shortSlLabels)
    f_clearLines(shortTpLines)
    f_clearLabels(shortTpLabels)

if shortEntryEvent
    longC1Set := false
    longC2Set := false
    if not na(longC1Line)
        line.delete(longC1Line)
        longC1Line := na
    if not na(longC1PendingLabel)
        label.delete(longC1PendingLabel)
        longC1PendingLabel := na
    if not na(longC2PendingLabel)
        label.delete(longC2PendingLabel)
        longC2PendingLabel := na
    if not na(longC3Label)
        label.delete(longC3Label)
        longC3Label := na
    if not na(longC1ConfirmedLabel)
        label.delete(longC1ConfirmedLabel)
        longC1ConfirmedLabel := na
    if not na(longC2Label)
        label.delete(longC2Label)
        longC2Label := na
    if not na(longZoneBox)
        box.delete(longZoneBox)
        longZoneBox := na
    if not na(longEntryLine)
        line.delete(longEntryLine)
        longEntryLine := na
    if not na(longEntryLabel)
        label.delete(longEntryLabel)
        longEntryLabel := na
    f_clearLines(longSlLines)
    f_clearLabels(longSlLabels)
    f_clearLines(longTpLines)
    f_clearLabels(longTpLabels)

// ============================================================================
// keep Entry/SL/TP labels pinned to the right end of their extension —
// with infinite extension that end is the current bar, so chase it every bar
// ============================================================================
if extendInfinite
    if not na(longEntryLabel)
        label.set_x(longEntryLabel, bar_index)
    for lb in longSlLabels
        label.set_x(lb, bar_index)
    for lb in longTpLabels
        label.set_x(lb, bar_index)
    if not na(shortEntryLabel)
        label.set_x(shortEntryLabel, bar_index)
    for lb in shortSlLabels
        label.set_x(lb, bar_index)
    for lb in shortTpLabels
        label.set_x(lb, bar_index)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(longEntryEvent, "MBZ Long Entry", "MBZ Long Entry bei {{close}}")
alertcondition(shortEntryEvent, "MBZ Short Entry", "MBZ Short Entry bei {{close}}")
